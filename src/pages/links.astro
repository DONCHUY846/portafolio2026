---
import LinksLayout from '../layouts/LinksLayout.astro';
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro/icons';
import { siGithub, siInstagram } from 'simple-icons';
import avatar from '../assets/avatar-frente.jpg';
import { linksPage } from '../data/links';

/** simple-icons retiró LinkedIn por trademark; el repo ya lo resuelve así en Footer.astro. */
const linkedinPath =
	'M347.445,0H34.555C15.471,0,0,15.471,0,34.555v312.889C0,366.529,15.471,382,34.555,382h312.889C366.529,382,382,366.529,382,347.444V34.555C382,15.471,366.529,0,347.445,0z M118.207,329.844c0,5.554-4.502,10.056-10.056,10.056H65.345c-5.554,0-10.056-4.502-10.056-10.056V150.403c0-5.554,4.502-10.056,10.056-10.056h42.806c5.554,0,10.056,4.502,10.056,10.056V329.844z M86.748,123.432c-22.459,0-40.666-18.207-40.666-40.666S64.289,42.1,86.748,42.1s40.666,18.207,40.666,40.666S109.208,123.432,86.748,123.432z M341.91,330.654c0,5.106-4.14,9.246-9.246,9.246H286.73c-5.106,0-9.246-4.14-9.246-9.246v-84.168c0-12.556,3.683-55.021-32.813-55.021c-28.309,0-34.051,29.066-35.204,42.11v97.079c0,5.106-4.139,9.246-9.246,9.246h-44.426c-5.106,0-9.246-4.14-9.246-9.246V149.593c0-5.106,4.14-9.246,9.246-9.246h44.426c5.106,0,9.246,4.14,9.246,9.246v15.655c10.497-15.753,26.097-27.912,59.312-27.912c73.552,0,73.131,68.716,73.131,106.472L341.91,330.654L341.91,330.654z';

const sentenceCase = (value: string) => value.charAt(0) + value.slice(1).toLowerCase();
---

<LinksLayout title={linksPage.title} description={linksPage.description}>
	<main class="links" data-links>
		<canvas class="links__canvas" data-links-canvas aria-hidden="true"></canvas>

		<div class="links__frame">
			<section class="links__profile" data-links-profile>
				<Image
					class="links__avatar"
					src={avatar}
					alt={linksPage.avatarAlt}
					widths={[240, 360]}
					sizes="200px"
					quality={100}
					format="webp"
					loading="eager"
					decoding="async"
				/>
				<h1 class="links__name">
					<span class="links__name-text" data-links-name>{linksPage.displayName}</span>
				</h1>
				<p class="links__role" data-links-role>{linksPage.role}</p>
				<p class="links__bio" data-links-bio>{linksPage.bio}</p>
			</section>

			<ul class="links__list">
				{
					linksPage.links.map((link) => (
						<li>
							<a
								class:list={['link-card', link.variant === 'primary' && 'link-card--primary']}
								data-links-card
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${sentenceCase(link.label)} de ${linksPage.fullName}`}
							>
								<span class="link-card__icon" aria-hidden="true">
									{link.icon === 'github' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
											<path d={siGithub.path} />
										</svg>
									)}
									{link.icon === 'linkedin' && (
										<svg viewBox="0 0 382 382" width="20" height="20" fill="currentColor">
											<path d={linkedinPath} />
										</svg>
									)}
									{link.icon === 'instagram' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
											<path d={siInstagram.path} />
										</svg>
									)}
									{link.icon === 'arrow' && <ArrowUpRight size={20} stroke-width={2} />}
								</span>
								<span class="link-card__body">
									<span class="link-card__label">{link.label}</span>
									<span class="link-card__hint">{link.hint}</span>
								</span>
								<ArrowUpRight class="link-card__arrow" size={18} stroke-width={2} aria-hidden="true" />
							</a>
						</li>
					))
				}
			</ul>

			<p class="links__footnote" data-links-footnote>{linksPage.footnote}</p>

			<button class="btn btn-secondary links__motion-cta" data-links-motion-cta type="button" hidden>
				{linksPage.motionCta}
			</button>
		</div>
	</main>
</LinksLayout>

<style>
	.links {
		position: relative;
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-lg);
		overflow: hidden;
	}

	.links__canvas {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		opacity: 0.7;
		pointer-events: none;
	}

	.links__frame {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 430px;
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.links__profile {
		background: var(--surface-card-color);
		border: var(--border-thick);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		padding: var(--space-lg);
		display: grid;
		justify-items: center;
		text-align: center;
		gap: var(--space-sm);
	}

	.links__avatar {
		width: 200px;
		height: 200px;
		object-fit: cover;
		border: var(--border-thin);
		border-radius: var(--radius-md);
	}

	.links__name-text {
		font-family: var(--headline-font);
		font-size: var(--font-headline-display-mobile-size);
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.links__role {
		font-family: var(--label-font);
		font-size: var(--font-code-size);
		color: var(--on-surface-variant-color);
	}

	.links__bio {
		font-family: var(--body-font);
		font-size: var(--font-body-md-size);
		line-height: 1.5;
		color: var(--on-surface-variant-color);
	}

	.links__list {
		display: grid;
		gap: var(--space-md);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.link-card {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		min-height: 64px;
		padding: var(--space-md) var(--space-lg);
		background: var(--surface-card-color);
		color: var(--primary-color);
		border: var(--border-thick);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
		transition:
			transform var(--transition-press),
			box-shadow var(--transition-press),
			background-color var(--transition-surface);
	}

	.link-card:hover,
	.link-card:focus-visible {
		transform: translate(-1px, -1px);
		box-shadow: var(--shadow-lg);
	}

	.link-card:active {
		transform: translate(2px, 2px);
		box-shadow: none;
	}

	.link-card:focus-visible {
		outline: var(--border-heavy);
		outline-offset: 2px;
	}

	.link-card--primary {
		background: var(--primary-color);
		color: var(--neutral-color);
	}

	.link-card--primary:hover,
	.link-card--primary:focus-visible {
		transform: none;
		box-shadow: var(--shadow-md);
	}

	.link-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.link-card__icon > svg {
		display: block;
	}

	.link-card__body {
		display: grid;
		gap: 2px;
		flex: 1;
		text-align: left;
	}

	.link-card__label {
		font-family: var(--headline-font);
		font-size: 18px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.link-card__hint {
		font-family: var(--label-font);
		font-size: var(--font-code-size);
		color: var(--on-surface-variant-color);
	}

	.link-card__arrow {
		flex-shrink: 0;
	}

	.link-card--primary .link-card__hint,
	.link-card--primary .link-card__arrow {
		color: rgba(230, 229, 223, 0.7);
	}

	.links__footnote {
		font-family: var(--label-font);
		font-size: var(--font-code-size);
		color: var(--outline-color);
		text-align: center;
		letter-spacing: 0.08em;
	}

	.links__motion-cta {
		align-self: center;
		padding: 8px 16px;
	}
</style>
