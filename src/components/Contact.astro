</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	const root = document.querySelector<HTMLElement>('[data-contact-root]');

	if (root) {
		const form = root.querySelector<HTMLFormElement>('[data-contact-form]');
		const notice = root.querySelector<HTMLElement>('[data-contact-notice]');

		const isFilled = (control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) =>
			control.value.trim().length > 0;

		const isValid = (
			control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
		) => {
			if (!isFilled(control)) return false;
			if (control instanceof HTMLInputElement && control.type === 'email') {
				return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(control.value.trim());
			}
			return true;
		};

		const setStatus = (
			control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
			state: 'valid' | 'invalid' | null,
			message: string,
		) => {
			const field = control.closest<HTMLElement>('[data-field]');
			const status = field?.querySelector<HTMLElement>('[data-field-status]');
			if (!status) return;

			status.textContent = message;
			if (state) {
				status.dataset.state = state;
			} else {
				delete status.dataset.state;
			}
		};

		const validate = (control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
			// Los `select` siempre traen un valor por defecto: no se validan.
			if (control instanceof HTMLSelectElement) return true;
			if (!control.required) return true;

			if (isValid(control)) {
				setStatus(control, 'valid', 'Campo válido');
				return true;
			}

			setStatus(
				control,
				'invalid',
				isFilled(control) ? 'Formato inválido' : 'Campo requerido',
			);
			return false;
		};

		if (form) {
			const controls = Array.from(
				form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-field-control]'),
			);

			controls.forEach((control) => {
				control.addEventListener('input', () => {
					if (isFilled(control)) validate(control);
				});
				control.addEventListener('blur', () => validate(control));
			});

			form.addEventListener('submit', (event) => {
				event.preventDefault();

				const invalid = controls.filter((control) => !validate(control));

				if (invalid.length > 0) {
					notice?.setAttribute('hidden', '');
					invalid[0].focus();
					return;
				}

				/*
				 * Sin backend por ahora: el diseño original también lo simula
				 * ("DESPACHO SIMULADO CON ÉXITO"). Cuando exista el endpoint
				 * real, reemplazar este bloque por el `fetch` correspondiente.
				 */
				notice?.removeAttribute('hidden');
				form.reset();
				controls.forEach((control) => {
					if (!(control instanceof HTMLSelectElement)) setStatus(control, null, '');
				});

				window.setTimeout(() => notice?.setAttribute('hidden', ''), 5000);
			});
		}

		const copyButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-copy]'));

		copyButtons.forEach((button) => {
			button.addEventListener('click', async () => {
				const value = button.dataset.copy;
				if (!value) return;

				try {
					await navigator.clipboard.writeText(value);
				} catch {
					return;
				}

				const original = button.textContent ?? '';
				button.textContent = '¡Copiado!';
				button.dataset.copied = 'true';

				window.setTimeout(() => {
					button.textContent = original;
					delete button.dataset.copied;
				}, 2000);
			});
		});

		const title = root.querySelector<HTMLElement>('[data-contact-title]');
		const lead = root.querySelector<HTMLElement>('.dossier__lead');
		const avatar = root.querySelector<HTMLElement>('[data-contact-avatar]');
		const blocks = Array.from(root.querySelectorAll<HTMLElement>('[data-contact-block]'));

		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			// `words,chars` evita que GSAP permita cortar linea a mitad de palabra.
			const titleSplit = title
				? new SplitText(title, { type: 'words,chars', charsClass: 'split-char' })
				: null;

			const introTl = gsap.timeline({ defaults: { ease: 'expo.out' } });

			if (titleSplit) {
				introTl.from(titleSplit.chars, { yPercent: 120, duration: 0.9, stagger: 0.02 }, 0.1);
			}
			if (lead) {
				introTl.from(lead, { y: 14, opacity: 0, duration: 0.6, ease: 'power3.out' }, 0.35);
			}

			gsap.set(avatar ?? [], { y: 24, autoAlpha: 0 });

			ScrollTrigger.batch(avatar ? [avatar] : [], {
				start: 'top 92%',
				onEnter: (batch) => {
					gsap.to(batch, {
						y: 0,
						autoAlpha: 1,
						duration: 0.7,
						ease: 'power3.out',
						overwrite: 'auto',
					});
				},
			});

			blocks.forEach((block) => {
				gsap.from(block, {
					scrollTrigger: {
						trigger: block,
						start: 'top 96%',
						once: true,
					},
					y: 20,
					autoAlpha: 0,
					duration: 0.7,
					ease: 'power3.out',
				});
			});

			return () => {
				titleSplit?.revert();
				gsap.set(avatar ? [avatar] : [], { clearProps: 'opacity,visibility,transform' });
			};
		});
	}
</script>
