---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar-frente.jpg';

const {
	firstName = 'JESÚS',
	lastName = 'AVIÑA',
	role = 'FRONTEND ARCHITECT',
	tagline = 'I build design systems, component libraries, and fast interfaces that stay maintainable as they scale.',
	primaryCta = { label: 'VER PROYECTOS', href: '#proyectos' },
	secondaryCta = { label: 'CONTACTO', href: '#contacto' },
	avatarAlt = 'Retrato de Jesús Aviña Alcalá',
} = Astro.props;
---

<section class="hero" data-hero>
	<canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>

	<div class="hero__body">
		<div class="hero__masthead">
			<h1 class="hero__name">
				<span class="hero__given" data-hero-given>
					<span class="hero__name-text" data-hero-name-text>{firstName}</span>
				</span>
				<span class="hero__card-wrap" data-hero-card-wrap>
					<span class="hero__card" data-hero-card>
						<Image
							class="hero__photo"
							src={avatar}
							alt={avatarAlt}
							widths={[240, 360, 480, 720]}
							sizes="(min-width: 1024px) 360px, 240px"
							quality={100}
							format="webp"
							loading="eager"
							decoding="async"
						/>
						<span class="hero__glare" data-hero-glare aria-hidden="true"></span>
					</span>
				</span>
				<span class="hero__family" data-hero-family>
					<span class="hero__name-text" data-hero-name-text>{lastName}</span>
				</span>
			</h1>
		</div>

		<div class="hero__intro" data-hero-intro>
			<p class="hero__role" data-hero-role>{role}</p>
			<p class="hero__tagline" data-hero-tagline>{tagline}</p>
		</div>

		<div class="hero__actions" data-hero-actions>
			<a class="btn btn-primary hero__cta" href={primaryCta.href}>
				<span>{primaryCta.label}</span>
				<span class="hero__arrow" aria-hidden="true">↗</span>
			</a>
			<a class="btn btn-secondary hero__cta" href={secondaryCta.href}>{secondaryCta.label}</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100svh;
		overflow: hidden;
		font-family: var(--label-font);
	}

	.hero__canvas {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		pointer-events: none;
	}

	.hero__body {
		position: relative;
		z-index: 1;
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-xl);
		max-width: 1200px;
		width: 100%;
		margin-inline: auto;
		padding: var(--space-xl) var(--gutter);
	}

	.hero__masthead {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.hero__name {
		display: contents;
	}

	.hero__given,
	.hero__family {
		flex: 1;
		overflow: hidden;
		padding-block: 0.15em;
		margin-block: -0.15em;
		font-family: var(--headline-font);
		font-weight: 700;
		font-size: clamp(2.75rem, 7.5vw, 7.5rem);
		line-height: 0.9;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--primary-color);
		white-space: nowrap;
	}

	.split-char {
		display: inline-block;
	}

	.hero__given {
		text-align: right;
	}

	.hero__family {
		text-align: left;
	}

	.hero__card-wrap {
		flex-shrink: 0;
		width: clamp(200px, 26vw, 360px);
		aspect-ratio: 4 / 5;
	}

	.hero__card {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		background-color: var(--surface-lowest-color);
		border-radius: var(--radius-lg);
		box-shadow: 0px 15px 20px var(--border-dark);
		overflow: hidden;
	}

	.hero__glare {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		opacity: 0;
		background: radial-gradient(
			420px circle at var(--gx, 50%) var(--gy, 50%),
			rgba(255, 255, 255, 0.38),
			transparent 45%
		);
	}

	.hero__photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 18%;
	}

	.hero__intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-md);
		text-align: center;
	}

	.hero__role {
		padding: 3px 10px;
		background-color: var(--surface-inset-color);
		border: var(--border-thin);
		border-radius: var(--radius-base);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--primary-color);
	}

	.hero__tagline {
		max-width: 52ch;
		font-family: var(--body-font);
		font-size: var(--font-body-lg-size);
		line-height: 28px;
		color: var(--on-surface-variant-color);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: var(--space-sm);
	}

	.hero__cta {
		cursor: pointer;
	}

	.hero__arrow {
		font-size: var(--font-body-sm-size);
	}

	@media (max-width: 1023px) {
		.hero__body {
			gap: var(--space-lg);
			padding: var(--space-lg) var(--gutter);
		}

		.hero__masthead {
			flex-direction: column;
			gap: var(--space-md);
		}

		.hero__name {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0;
		}

		.hero__given,
		.hero__family {
			font-size: clamp(2.75rem, 13vw, 3.5rem);
			line-height: 0.95;
			text-align: center;
		}

		.hero__card-wrap {
			width: 240px;
			margin-block: var(--space-md);
		}

		.hero__card {
			box-shadow: 4px 4px 0px var(--border-dark);
		}

		.hero__tagline {
			max-width: 34ch;
			font-size: var(--font-body-md-size);
			line-height: 24px;
		}

		.hero__actions {
			flex-direction: column;
			width: 100%;
			max-width: 340px;
		}

		.hero__cta {
			width: 100%;
			min-height: 48px;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';
	import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';

	gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);

	const hero = document.querySelector<HTMLElement>('[data-hero]');

	if (hero) {
		const card = hero.querySelector<HTMLElement>('[data-hero-card]');
		const cardWrap = hero.querySelector<HTMLElement>('[data-hero-card-wrap]');
		const glare = hero.querySelector<HTMLElement>('[data-hero-glare]');
		const given = hero.querySelector<HTMLElement>('[data-hero-given]');
		const family = hero.querySelector<HTMLElement>('[data-hero-family]');
		const intro = hero.querySelector<HTMLElement>('[data-hero-intro]');
		const actions = hero.querySelector<HTMLElement>('[data-hero-actions]');
		const roleEl = hero.querySelector<HTMLElement>('[data-hero-role]');
		const taglineEl = hero.querySelector<HTMLElement>('[data-hero-tagline]');
		const nameTexts = hero.querySelectorAll<HTMLElement>('[data-hero-name-text]');

		const mm = gsap.matchMedia();

		mm.add('(prefers-reduced-motion: no-preference)', () => {
			if (!card || !roleEl || !taglineEl) return;

			const nameSplits = Array.from(nameTexts).map(
				(el) => new SplitText(el, { type: 'chars', charsClass: 'split-char' }),
			);
			const chars = nameSplits.flatMap((split) => Array.from(split.chars));
			const taglineSplit = new SplitText(taglineEl, { type: 'words', wordsClass: 'split-word' });
			const roleText = roleEl.textContent ?? '';

			const tl = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } });

			tl.fromTo(
				card,
				{ clipPath: 'inset(0 0 100% 0)', scale: 0.9, rotate: -2 },
				{ clipPath: 'inset(0 0 0% 0)', scale: 1, rotate: 0, duration: 1.1 },
				0,
			);
			tl.from(chars, { yPercent: 150, duration: 0.9, stagger: 0.03 }, 0.15);
			tl.from(roleEl, { y: 8, opacity: 0, duration: 0.5, ease: 'power3.out' }, 0.5);
			tl.to(
				roleEl,
				{
					scrambleText: { text: roleText, chars: 'upperCase', speed: 0.35, revealDelay: 0.15 },
					duration: 1.2,
					ease: 'none',
					onStart: () => {
						roleEl.textContent = '';
					},
				},
				0.55,
			);
			tl.from(
				taglineSplit.words,
				{ y: 16, opacity: 0, duration: 0.6, stagger: 0.015, ease: 'power3.out' },
				0.7,
			);
			if (actions) {
				tl.from(actions, { y: 12, opacity: 0, duration: 0.5, ease: 'power3.out' }, 0.95);
			}

			let started = false;
			const play = () => {
				if (started) return;
				started = true;
				tl.play();
				ScrollTrigger.refresh();
			};

			if (document.fonts?.ready) document.fonts.ready.then(play).catch(play);
			window.setTimeout(play, 1200);

			return () => {
				started = true;
				tl.kill();
				nameSplits.forEach((split) => split.revert());
				taglineSplit.revert();
			};
		});

		mm.add('(prefers-reduced-motion: no-preference) and (min-width: 1024px)', () => {
			if (!given || !family || !cardWrap || !intro) return;

			const tl = gsap.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6 },
			});

			tl.to(given, { xPercent: -12 }, 0)
				.to(family, { xPercent: 12 }, 0)
				.to(cardWrap, { yPercent: 14, scale: 0.95, opacity: 0.6 }, 0)
				.to(intro, { y: -60, opacity: 0.3 }, 0);
		});

		mm.add('(prefers-reduced-motion: no-preference) and (max-width: 1023px)', () => {
			if (!given || !family || !cardWrap || !intro) return;

			const tl = gsap.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6 },
			});

			tl.to(given, { yPercent: -6 }, 0)
				.to(family, { yPercent: 6 }, 0)
				.to(cardWrap, { scale: 0.96, opacity: 0.6 }, 0)
				.to(intro, { y: -30, opacity: 0.4 }, 0);
		});

		mm.add('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)', () => {
			if (!card || !glare) return;

			gsap.set(card, { transformPerspective: 900 });

			const rotX = gsap.quickTo(card, 'rotationX', { duration: 0.5, ease: 'power3' });
			const rotY = gsap.quickTo(card, 'rotationY', { duration: 0.5, ease: 'power3' });
			const moveX = gsap.quickTo(card, 'x', { duration: 0.5, ease: 'power3' });
			const moveY = gsap.quickTo(card, 'y', { duration: 0.5, ease: 'power3' });
			const glareO = gsap.quickTo(glare, 'opacity', { duration: 0.3, ease: 'power2' });

			const onMove = (event: PointerEvent) => {
				const rect = card.getBoundingClientRect();
				const px = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
				const py = Math.min(Math.max((event.clientY - rect.top) / rect.height, 0), 1);
				rotY((px - 0.5) * 14);
				rotX((0.5 - py) * 14);
				moveX((px - 0.5) * 12);
				moveY((py - 0.5) * 12);
				glare.style.setProperty('--gx', `${px * 100}%`);
				glare.style.setProperty('--gy', `${py * 100}%`);
				glareO(1);
			};

			const onLeave = () => {
				rotX(0);
				rotY(0);
				moveX(0);
				moveY(0);
				glareO(0);
			};

			card.addEventListener('pointermove', onMove);
			card.addEventListener('pointerleave', onLeave);

			return () => {
				card.removeEventListener('pointermove', onMove);
				card.removeEventListener('pointerleave', onLeave);
				gsap.set(card, { clearProps: 'transform,perspective' });
				gsap.set(glare, { clearProps: 'opacity' });
				glare.style.removeProperty('--gx');
				glare.style.removeProperty('--gy');
			};
		});

		const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-canvas]');

		const loadGrid = () => {
			if (!canvas) return;
			if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
			import('../scripts/hero-grid')
				.then((module) => module.initHeroGrid(canvas))
				.catch(() => {});
		};

		if (typeof window.requestIdleCallback === 'function') {
			window.requestIdleCallback(loadGrid, { timeout: 2000 });
		} else {
			window.addEventListener('load', loadGrid, { once: true });
		}
	}
</script>

