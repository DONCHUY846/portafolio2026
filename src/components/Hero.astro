---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar-frente.jpg';

const {
	brand = '[ JA ] // DEV',
	firstName = 'JESÚS',
	lastName = 'AVIÑA',
	role = 'FRONTEND ARCHITECT',
	tagline = 'I build design systems, component libraries, and fast interfaces that stay maintainable as they scale.',
	location = 'MÉXICO / LATAM',
	timezone = 'GMT-6',
	primaryCta = { label: 'VER PROYECTOS', href: '#proyectos' },
	secondaryCta = { label: 'CONTACTO', href: '#contacto' },
	avatarAlt = 'Retrato de Jesús Aviña Alcalá',
} = Astro.props;
---

<section class="hero">


	<div class="hero__body">
		<div class="hero__masthead">
			<h1 class="hero__name">
				<span class="hero__given">{firstName}</span>
				<span class="hero__card">
					<Image
						class="hero__photo"
						src={avatar}
						alt={avatarAlt}
						widths={[240, 360, 480, 720]}
						sizes="(min-width: 1024px) 360px, 240px"
						quality={100}
						format="webp"
						loading="eager"
						decoding="async"
					/>
				</span>
				<span class="hero__family">{lastName}</span>
			</h1>
		</div>

		<div class="hero__intro">
			<p class="hero__role">{role}</p>
			<p class="hero__tagline">{tagline}</p>
		</div>
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100svh;
		font-family: var(--label-font);
	}

	.hero__rail {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding: 12px var(--gutter);
		border-bottom: var(--border-thin);
	}

	.hero__brand {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--primary-color);
		white-space: nowrap;
	}

	.hero__place {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.hero__dot {
		width: 8px;
		height: 8px;
		flex-shrink: 0;
		border-radius: var(--radius-full);
		background-color: var(--status-available);
		animation: hero-pulse 2s ease-in-out infinite;
	}

	.hero__timezone {
		font-size: 10px;
		color: var(--outline-color);
		white-space: nowrap;
	}

	.hero__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-xl);
		max-width: 1200px;
		width: 100%;
		margin-inline: auto;
		padding: var(--space-xl) var(--gutter);
	}

	.hero__masthead {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.hero__name {
		display: contents;
	}

	.hero__given,
	.hero__family {
		flex: 1;
		font-family: var(--headline-font);
		font-weight: 700;
		font-size: clamp(2.75rem, 7.5vw, 7.5rem);
		line-height: 0.9;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--primary-color);
		white-space: nowrap;
	}

	.hero__given {
		text-align: right;
	}

	.hero__family {
		text-align: left;
	}

	.hero__card {
		flex-shrink: 0;
		width: clamp(200px, 26vw, 360px);
		aspect-ratio: 4 / 5;
		background-color: var(--surface-lowest-color);
		border-radius: var(--radius-lg);
		box-shadow: 0px 15px 20px var(--border-dark);
		overflow: hidden;
	}

	.hero__photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 18%;
	}

	.hero__intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-md);
		text-align: center;
	}

	.hero__role {
		padding: 3px 10px;
		background-color: var(--surface-inset-color);
		border: var(--border-thin);
		border-radius: var(--radius-base);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--primary-color);
	}

	.hero__tagline {
		max-width: 52ch;
		font-family: var(--body-font);
		font-size: var(--font-body-lg-size);
		line-height: 28px;
		color: var(--on-surface-variant-color);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: var(--space-sm);
	}

	.hero__cta {
		font-family: var(--label-font);
		font-size: var(--font-code-size);
		font-weight: 700;
		letter-spacing: 0.08em;
		cursor: pointer;
	}

	.btn-secondary:hover {
		box-shadow: var(--shadow-sm);
	}

	.hero__arrow {
		font-size: var(--font-body-sm-size);
	}

	@keyframes hero-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.35;
		}
	}

	@media (max-width: 1023px) {
		.hero__body {
			gap: var(--space-lg);
			padding: var(--space-lg) var(--gutter);
		}

		.hero__masthead {
			flex-direction: column;
			gap: var(--space-md);
		}

		.hero__name {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0;
		}

		.hero__given,
		.hero__family {
			font-size: clamp(2.75rem, 13vw, 3.5rem);
			line-height: 0.95;
			text-align: center;
		}

		.hero__card {
			width: 240px;
			margin-block: var(--space-md);
			box-shadow: 4px 4px 0px var(--border-dark);
		}

		.hero__tagline {
			max-width: 34ch;
			font-size: var(--font-body-md-size);
			line-height: 24px;
		}

		.hero__actions {
			flex-direction: column;
			width: 100%;
			max-width: 340px;
		}

		.hero__cta {
			width: 100%;
			min-height: 48px;
		}
	}
</style>
